            "@type": "FAQPage",
            "@id": "https://www.imd.org/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What is IMD Business School?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD (International Institute for Management Development) is an independent, non-profit business school based in Lausanne, Switzerland. Founded in 1946, IMD is ranked #1 in the world for custom executive education programs (Financial Times, 2025) and consistently ranks among the world's top business schools. IMD offers 80+ executive education programs, MBA, EMBA, and Masters degrees, as well as custom corporate learning solutions for organizations worldwide."
                }
              },
              {
                "@type": "Question",
                "name": "Where is IMD Business School located?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD Business School is located at Chemin de Bellerive 23, Lausanne, Switzerland (Canton Vaud). The campus is situated on the shores of Lake Geneva. IMD also has a presence in Singapore and Shenzen (China) and offers programs globally."
                }
              },
              {
                "@type": "Question",
                "name": "What programs does IMD offer?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD offers a comprehensive range of programs including: degree programs (MBA, Executive MBA, MSc in Sustainable Management &amp; Technology, Executive Master in Sustainable Business Transformation, Executive Master in AI &amp; Digital Business Transformation); 80+ open-enrollment executive education programs across leadership, strategy, digital transformation, sustainability, finance, innovation, and more; online and Sprint programs; executive certificates and diplomas; and custom corporate programs designed for organizations."
                }
              },
              {
                "@type": "Question",
                "name": "How is IMD Business School ranked?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD Business School is ranked #1 in the world for custom executive education programs by the Financial Times in 2025. IMD consistently appears in the top tier of global business school rankings across executive education, MBA, and EMBA categories."
                }
              },
              {
                "@type": "Question",
                "name": "Is IMD Business School accredited?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, IMD Business School holds triple accreditation — the gold standard in business education — from AACSB, EQUIS, and AMBA. This places IMD among a small elite of business schools worldwide that have achieved all three major international accreditations."
                }
              },
              {
                "@type": "Question",
                "name": "What is the IMD World Competitiveness Ranking?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The IMD World Competitiveness Ranking is an annual report published by IMD's World Competitiveness Center that evaluates and ranks the competitiveness of 69 global economies. It is one of the most widely cited economic competitiveness benchmarks in the world, used by governments, businesses, and researchers to understand the economic performance and business environment of countries."
                }
              },
              {
                "@type": "Question",
                "name": "How large is the IMD alumni network?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD has a global alumni network of more than 145,000 executives who have participated in IMD programs across the school's history. The IMD Alumni Association connects this network through clubs, events, and communities organized by geography, program, and industry."
                }
              },
              {
                "@type": "Question",
                "name": "What is the difference between IMD's MBA and EMBA programs?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "IMD's MBA is a full-time, one-year degree program designed for professionals typically with 3–10 years of experience who want to accelerate their careers or make a significant career transition. The Executive MBA (EMBA) is designed for senior professionals and executives with significant work experience who wish to continue working while earning their degree. Both programs are based in Lausanne, Switzerland and are known for their intensive, practice-oriented approach."
                }
              },
              {
                "@type": "Question",
                "name": "Does IMD offer online programs?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, IMD offers a range of online programs including online executive education programs, Sprint programs (short, focused online courses in areas like Generative AI, Digital Transformation, and Resilient Leadership), and online executive certificates in Leadership, Strategy, and Digital Acceleration. These programs allow executives to develop skills flexibly without leaving their roles."
                }
              },
              {
                "@type": "Question",
                "name": "What is I by IMD?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "I by IMD is IMD's thought leadership platform, providing first-person business intelligence, research, articles, podcasts, and insights from IMD faculty, researchers, and industry leaders. It covers topics including leadership, strategy, digital transformation, sustainability, geopolitics, and innovation."
                }
              }
            ]
